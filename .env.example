# ==============================================================================
# DITO WEB DESIGN - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Rename this file to .env or create a .env file in the root directory.
# NEVER commit .env with real secrets to public version control!
# ==============================================================================

# Server Port (Default: 3000)
PORT=3000

# Destination Email for Client Project Inquiries
CONTACT_EMAIL=ditowebdesign@gmail.com

# Sender Identity for Resend (Must use verified domain or Resend testing address)
EMAIL_FROM=Dito Web Design <onboarding@resend.dev>

# Resend API Key
# 1. Sign up for free at https://resend.com
# 2. Create an API Key in your Resend Dashboard (e.g. re_123456789)
# 3. Paste it below. If left blank, the server will securely log inquiries in local dev mode.
RESEND_API_KEY=
